# ==============================================================================
# EUTHIAL PROTOCOL (WEB APP) — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env.local` for Next.js local development.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
DATABASE_URL="file:./dev.db"

# --- AUTHENTICATION (Auth.js / NextAuth v5) ---
AUTH_SECRET="euthial-protocol-secret-key-development-mode-2026"
NEXTAUTH_URL="http://localhost:3000"

# --- WEB3 & BLOCKCHAIN NETWORK CONFIGURATION ---
NEXT_PUBLIC_DEFAULT_CHAIN_ID=11155111
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="3a8170812b534d0ff9d794f168da2d7b"
NEXT_PUBLIC_SEPOLIA_RPC="https://ethereum-sepolia-rpc.publicnode.com"

# --- CONTRACT ADDRESSES ---
NEXT_PUBLIC_FITOUT_AGREEMENT_ADDRESS="0x71C95911E9A5D330f4D621842EC243EE1343292e"
NEXT_PUBLIC_SENIOR_VAULT_ADDRESS="0x94845333028B1204Fbe14E1278Fd4Adde46B22ce"
NEXT_PUBLIC_JUNIOR_VAULT_ADDRESS="0x6b175474e89094c44da98b954eedeac495271d0f"
NEXT_PUBLIC_EUTHIAL_IDR_ADDRESS="0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174"

# --- SENTRY ERROR MONITORING ---
# Public DSN is safe to expose in browser bundles.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_RELEASE=""

# Optional server-only DSN. If omitted, server instrumentation falls back to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""

# Required in CI/CD for automatic source map upload. Never expose this token publicly.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional: set to 1 to make the Sentry Webpack plugin verbose during build troubleshooting.
SENTRY_DEBUG=""
